{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/spec/**)",
      "Read(.env*)"
    ],
    "ask": [
      "Edit(/PROJECT_BRIEF.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/pom.xml)",
      "Edit(/ledger-app/pom.xml)",
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/roles/**)",
      "Edit(/scripts/claude-role.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/role-guard.sh"
          }
        ]
      }
    ]
  }
}
