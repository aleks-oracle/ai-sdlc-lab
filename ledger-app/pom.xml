<?xml version="1.0" encoding="UTF-8"?>
<!--
  ledger-app: Spring Boot application, a thin layer over ledger-core.
  Stage 1: only an empty LedgerApplication and a context-loads smoke test.
  No web, Actuator or persistence yet.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.aleks-oracle</groupId>
        <artifactId>ledger-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ledger-app</artifactId>
    <name>ai-sdlc-lab :: ledger-app</name>

    <properties>
        <!--
          ledger-app is the ONLY module allowed to opt out of these root enforcer rules:
          it is the Spring module, and it depends on ledger-core.
          PROTECTED: no other module may set these (CLAUDE.md).
        -->
        <ledger.rules.no-spring.skip>true</ledger.rules.no-spring.skip>
        <ledger.rules.no-sut-modules.skip>true</ledger.rules.no-sut-modules.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.aleks-oracle</groupId>
            <artifactId>ledger-core</artifactId>
        </dependency>
        <!-- core Spring Boot starter: DI container, auto-configuration, logging. No web server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- JUnit 6, AssertJ, Spring test support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Without the Boot parent we bind "repackage" ourselves. It turns the plain jar into an
              executable jar (java -jar ledger-app.jar) that contains all dependencies.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
